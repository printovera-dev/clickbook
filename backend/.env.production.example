# ClickBook API — production environment (copy to backend/.env.production and fill in)
DB_NAME=clickbook
APP_ENV=production
LOG_LEVEL=info
WEB_CONCURRENCY=3

# Storage (VPS disk inside the api container volume). Switch to S3-compatible by setting STORAGE_DRIVER=s3 + S3_* vars.
STORAGE_DRIVER=local

# Razorpay (LIVE)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# WhatsApp OTP (aoc-portal)
WHATSAPP_PROVIDER=aoc
WHATSAPP_API_URL=https://api.aoc-portal.com/v1/whatsapp
WHATSAPP_API_KEY=xxxxxxxxxxxxxxxx
WHATSAPP_FROM=+919999999999
WHATSAPP_TEMPLATE=clickbook
WHATSAPP_CAMPAIGN=clickbook-otp
