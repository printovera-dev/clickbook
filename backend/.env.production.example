# Printovera / ClickBook API — production environment example (set real secrets in hosting dashboard, never commit them)
DB_NAME=clickbook
APP_ENV=production
LOG_LEVEL=info
WEB_CONCURRENCY=3

# Durable S3 storage (configure these variables in Kuberns; never commit real credentials).
# Keep the bucket in the same AWS region as the backend for lower latency.
STORAGE_DRIVER=s3
S3_ACCESS_KEY=replace-in-hosting-dashboard
S3_SECRET_KEY=replace-in-hosting-dashboard
S3_BUCKET=replace-with-your-bucket-name
S3_REGION=ap-southeast-2
S3_ENDPOINT=

# Razorpay (LIVE) — configure these securely in the hosting dashboard
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-in-hosting-dashboard
RAZORPAY_WEBHOOK_SECRET=replace-in-hosting-dashboard

# WhatsApp OTP (GreenTick / AOC Portal) — set secrets in the deployed backend environment
WHATSAPP_PROVIDER=aoc
WHATSAPP_API_URL=https://api.aoc-portal.com/v1/whatsapp
WHATSAPP_API_KEY=replace-in-hosting-dashboard
WHATSAPP_FROM=+919999674261
WHATSAPP_TEMPLATE=authentication
WHATSAPP_CAMPAIGN=clickbook-otp
